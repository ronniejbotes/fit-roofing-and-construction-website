# Apache / LiteSpeed configuration for the static mirror.
#
# WHY THIS FILE EXISTS
# _redirects is Netlify / Cloudflare Pages syntax. Hostinger runs LiteSpeed,
# which never reads it — on 21 September 2026 all 44 rules in _redirects were
# confirmed dead on the live host, every one answering 404, and the custom
# 404 page was not being served either. This file is the same rule set in the
# syntax this host does read. _redirects stays as the source of truth and for
# tools/serve.mjs; the two must be kept in step.
#
# Order matters: first match wins, so specific rules sit above the patterns.
# RewriteRule sees the path WITHOUT its leading slash.

# The mirror's own 404 template, with a real 404 status.
ErrorDocument 404 /404.html

# Directory listings are not part of the site.
Options -Indexes

# Stored enquiries carry a name, a phone number and an address. _forms/leads/
# denies itself as well; this is the second lock, so losing one file in a
# deploy does not put customer details on the open web.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^_forms/leads(/.*)?$ - [F,L]
</IfModule>

# The repo root is the web root, so every file committed here is published at
# the client's domain unless it is refused. Our migration notes, the README,
# the route manifest, the Node tooling and its manifests are not part of the
# site, and until this block all of them answered 200 on fitroofingco.com.
# Refused with the same [F] as the lock above: a 403, and no redirect.
# Still served: robots.txt, llms.txt, the three sitemaps, 404.html,
# /_forms/submit.php, every page, and everything under /wp-content/,
# /wp-includes/ and /assets/ (including the lottie .json and the sitemap .xsl).
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Markdown and Node modules, at any depth. No page or asset uses either;
    # if the site ever ships an .mjs module, narrow this rule first.
    RewriteRule \.(md|mjs)$ - [NC,F,L]
    # The tooling folder, and working folders a folder-based upload would carry.
    RewriteRule ^(tools|node_modules|shots)(/|$) - [F,L]
    # Root manifests: the npm files and the capture's route list.
    RewriteRule ^(package|package-lock)\.json$ - [F,L]
    RewriteRule ^routes\.txt$ - [F,L]
    # Anything whose first segment starts with an underscore is ours:
    # _redirects (Netlify syntax this host never reads), the gitignored _raw/
    # capture and _*.mjs probes. The one exception is the enquiry handler.
    RewriteCond %{REQUEST_URI} !^/_forms/submit\.php$
    RewriteRule ^_ - [F,L]
    # Dot files and folders: .git/, .gitignore, .gitattributes, .nojekyll.
    # /.well-known/ stays open, because certificate renewal can depend on it.
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteRule (^|/)\. - [F,L]
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On

# ---- Old service URLs -------------------------------------------------------
# The service pages used to live under /services/. Still linked from /blog/
# on the old site and indexed under these paths.
RewriteRule ^services/attics/?$                 /attics-texas/                [R=301,L]
RewriteRule ^services/commercial-roofing/?$     /commercial-roofing-texas/    [R=301,L]
RewriteRule ^services/gutter-installation/?$    /gutter-installation-texas/   [R=301,L]
RewriteRule ^services/roof-installation/?$      /roof-installation-texas/     [R=301,L]
RewriteRule ^services/roof-repair/?$            /roof-repair-texas/           [R=301,L]
RewriteRule ^services/storm-repair/?$           /storm-repair-texas/          [R=301,L]
RewriteRule ^services/skylight-installation/?$  /skylight-installation-texas/ [R=301,L]
RewriteRule ^services/roof-replacement/?$       /roof-replacement-texas/      [R=301,L]

# ---- Old slugs the WordPress site redirected --------------------------------
# Both were stored redirects on the old site, not WordPress guessing from a
# prefix: on 17 September 2026 each answered 301 to the page below, while
# /locati/ and /forth/ answered 404. Neither made it into _redirects, so both
# have answered 404 since the move. /forth-worth/ is the misspelt city slug.
RewriteRule ^location/?$     /roofing-locations/  [R=301,L]
RewriteRule ^forth-worth/?$  /fort-worth/         [R=301,L]

# ---- Archives Yoast has switched off ----------------------------------------
# Both real author archives go to the homepage. Unknown authors 404 on the old
# site, so there is deliberately no /author/* catch-all.
RewriteRule ^author/p3akl3ads/?$  /  [R=301,L]
RewriteRule ^author/seodev2/?$    /  [R=301,L]

# Date archives: every 2026 archive (year, month, day) goes to the homepage.
# 2026 is the only year with posts. Anchored, so /wp-content/uploads/2026/...
# is untouched.
RewriteRule ^2026(/.*)?$  /  [R=301,L]

# The old default-category path, and the retired "home" slug. /home carried the
# header logo on every page until 856d749.
RewriteRule ^category/uncategorized/?$  /uncategorized/  [R=301,L]
RewriteRule ^home/?$                    /                [R=301,L]

# ---- Feeds, switched off ----------------------------------------------------
# /comments/feed/ must stay above the /:slug/feed/ pattern, or it would be sent
# to /comments/, which does not exist.
RewriteRule ^feed/atom/?$      /       [R=301,L]
RewriteRule ^feed/rss2/?$      /feed/  [R=301,L]
RewriteRule ^feed/?$           /       [R=301,L]
RewriteRule ^rss/?$            /feed/  [R=301,L]
RewriteRule ^comments/feed/?$  /       [R=301,L]
RewriteRule ^tag/([^/]+)/feed/?$  /tag/$1/  [R=301,L]
RewriteRule ^([^/]+)/feed/?$      /$1/      [R=301,L]

# ---- WordPress core ---------------------------------------------------------
RewriteRule ^sitemap\.xml$     /sitemap_index.xml  [R=301,L]
RewriteRule ^wp-sitemap\.xml$  /sitemap_index.xml  [R=301,L]
RewriteRule ^index\.php$       /                   [R=301,L]
RewriteRule ^blog/page/1/?$    /blog/              [R=301,L]

# The old site answers this one 302, not 301. Kept as it is.
RewriteRule ^favicon\.ico$  /wp-content/uploads/2026/03/cropped-Gold-house-roof-and-windows-icon-1-32x32.png  [R=302,L]
</IfModule>
